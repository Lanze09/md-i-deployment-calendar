# Supabase credentials — get these from your Supabase project dashboard
# (Settings → API). The anon key is safe to expose in frontend code.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =====================================================================
# Gemini API key — REQUIRED for AI features (Insights, chat, conflict
# explainer, per-deployment AI summary). Get a free key at
# https://aistudio.google.com/app/apikey
#
# IMPORTANT:
# - Restart the dev server after changing this file (`npm run dev`).
# - Vite inlines VITE_* values into the build output at `npm run build`
#   time. If you publish dist/ to a public host (e.g. GitHub Pages),
#   anyone who downloads it can read this key and burn through your
#   free-tier quota. For shared deployments, run AI calls through a
#   Supabase Edge Function instead. For private / single-user use this
#   is fine.
# =====================================================================
VITE_GEMINI_API_KEY=

# Optional: lock to a specific Gemini model. If unset the app tries
# gemini-2.5-flash, then gemini-2.5-flash-lite, then gemini-1.5-flash-8b
# in order, automatically falling back on per-model quota errors.
# VITE_GEMINI_MODEL=gemini-2.5-flash
